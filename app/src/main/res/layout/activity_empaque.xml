<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/primary"
            app:navigationIcon="@drawable/ic_menu"
            app:navigationIconTint="@color/on_primary"
            android:minHeight="@dimen/ui_toolbar_height"
            app:title="@string/empaque_nav_create"
            app:titleTextAppearance="@style/TextAppearance.Material3.TitleMedium"
            app:titleTextColor="@color/on_primary">

            <include
                android:id="@+id/userSession"
                layout="@layout/include_user_session"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginEnd="8dp" />
        </com.google.android.material.appbar.MaterialToolbar>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/loadingContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp">

                <ProgressBar
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/empaque_loading"
                    android:textColor="@color/on_background"
                    android:textSize="16sp" />
            </LinearLayout>

            <ScrollView
                android:id="@+id/workspaceContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/ui_screen_padding">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tipoSectionTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:text="@string/empaque_filter_label"
                            android:textColor="@color/on_background"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <ImageButton
                            android:id="@+id/filterFinalButton"
                            android:layout_width="@dimen/ui_filter_button"
                            android:layout_height="@dimen/ui_filter_button"
                            android:background="@drawable/bg_filter_icon_selected"
                            android:contentDescription="@string/empaque_filter_final"
                            android:padding="@dimen/ui_filter_icon_padding"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_lote_final"
                            android:tint="@color/on_background" />

                        <ImageButton
                            android:id="@+id/filterNoFinalButton"
                            android:layout_width="@dimen/ui_filter_button"
                            android:layout_height="@dimen/ui_filter_button"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_filter_icon_idle"
                            android:contentDescription="@string/empaque_filter_no_final"
                            android:padding="@dimen/ui_filter_icon_padding"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_lote_stack"
                            android:tint="@color/on_background" />
                    </LinearLayout>

                    <HorizontalScrollView
                        android:id="@+id/tiposScroll"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:clipToPadding="false"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/tiposList"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" />
                    </HorizontalScrollView>

                    <TextView
                        android:id="@+id/tiposEmptyText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/empaque_tipos_empty"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="12sp"
                        android:visibility="gone" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:layout_marginTop="@dimen/ui_section_gap"
                        android:background="@color/outline" />

                    <LinearLayout
                        android:id="@+id/loteDetailRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/empaque_lote_label"
                            android:textColor="@color/on_background"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/loteIdInput"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_lote_id_input"
                            android:hint="@string/empaque_lote_id_hint"
                            android:imeOptions="actionSearch"
                            android:importantForAutofill="no"
                            android:inputType="number"
                            android:maxLines="1"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:textColor="@color/on_background"
                            android:textColorHint="@color/on_surface_variant"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <FrameLayout
                            android:layout_width="@dimen/ui_action_button"
                            android:layout_height="@dimen/ui_action_button"
                            android:layout_marginEnd="4dp">

                            <ImageButton
                                android:id="@+id/createButton"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:contentDescription="@string/empaque_create"
                                android:enabled="false"
                                android:padding="10dp"
                                android:scaleType="centerInside"
                                android:src="@drawable/ic_add"
                                android:tint="@color/on_background" />

                            <ImageButton
                                android:id="@+id/deleteLoteButton"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:contentDescription="@string/empaque_gestion_delete"
                                android:padding="10dp"
                                android:scaleType="centerInside"
                                android:src="@drawable/ic_delete"
                                android:tint="@color/on_background"
                                android:visibility="gone" />
                        </FrameLayout>

                        <ImageButton
                            android:id="@+id/printEtiquetaButton"
                            android:layout_width="@dimen/ui_action_button"
                            android:layout_height="@dimen/ui_action_button"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/empaque_etiqueta_pdf"
                            android:enabled="false"
                            android:padding="10dp"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_print"
                            android:tint="@color/on_background"
                            android:visibility="gone" />

                        <ImageButton
                            android:id="@+id/clearButton"
                            android:layout_width="@dimen/ui_action_button"
                            android:layout_height="@dimen/ui_action_button"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/empaque_clear"
                            android:enabled="false"
                            android:padding="10dp"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_eraser"
                            android:tint="@color/on_background" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/loteInfoSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingEnd="8dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="start"
                                    android:text="@string/empaque_lote_field_tipo"
                                    android:textAlignment="viewStart"
                                    android:textColor="@color/on_surface_variant"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/loteTipoValue"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:layout_weight="1"
                                    android:ellipsize="end"
                                    android:gravity="end"
                                    android:maxLines="2"
                                    android:textAlignment="viewEnd"
                                    android:textColor="@color/primary"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="start"
                                    android:text="@string/empaque_lote_field_padre"
                                    android:textAlignment="viewStart"
                                    android:textColor="@color/on_surface_variant"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/lotePadreValue"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:layout_weight="1"
                                    android:ellipsize="end"
                                    android:gravity="end"
                                    android:maxLines="1"
                                    android:textAlignment="viewEnd"
                                    android:textColor="@color/primary"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="start"
                                    android:text="@string/empaque_lote_field_creado"
                                    android:textAlignment="viewStart"
                                    android:textColor="@color/on_surface_variant"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/loteCreadoValue"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:layout_weight="1"
                                    android:ellipsize="end"
                                    android:gravity="end"
                                    android:maxLines="2"
                                    android:textAlignment="viewEnd"
                                    android:textColor="@color/primary"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/loteEstatusText"
                            android:layout_width="112dp"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_lote_estatus"
                            android:gravity="center"
                            android:minHeight="72dp"
                            android:padding="8dp"
                            android:textColor="@color/primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/ubicacionesSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/empaque_origen_title"
                                android:textColor="@color/on_surface_variant"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/origenValue"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:gravity="end"
                                android:maxLines="2"
                                android:textAlignment="viewEnd"
                                android:textColor="@color/primary"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/empaque_destino_title"
                            android:textColor="@color/on_background"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/destinoValue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/destinoClaveInput"
                            android:layout_width="match_parent"
                            android:layout_height="36dp"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/bg_lote_id_input"
                            android:drawablePadding="6dp"
                            android:drawableStart="@drawable/ic_search"
                            android:hint="@string/empaque_destino_clave_hint"
                            android:importantForAutofill="no"
                            android:imeOptions="actionDone"
                            android:inputType="text"
                            android:maxLines="1"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:textColor="@color/on_background"
                            android:textColorHint="@color/on_surface_variant"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/referenciasScanSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/empaque_referencia_scan_title"
                            android:textColor="@color/on_background"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <Spinner
                                android:id="@+id/referenciasScanTipoSpinner"
                                android:layout_width="96dp"
                                android:layout_height="36dp"
                                android:background="@drawable/bg_lote_id_input"
                                android:paddingStart="2dp"
                                android:paddingEnd="2dp" />

                            <EditText
                                android:id="@+id/referenciasScanInput"
                                android:layout_width="0dp"
                                android:layout_height="36dp"
                                android:layout_marginStart="4dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_lote_id_input"
                                android:hint="@string/empaque_referencia_scan_hint"
                                android:importantForAutofill="no"
                                android:imeOptions="actionDone"
                                android:inputType="text"
                                android:maxLines="1"
                                android:paddingStart="10dp"
                                android:paddingEnd="10dp"
                                android:textColor="@color/on_background"
                                android:textColorHint="@color/on_surface_variant"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/loteReferenciasSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/loteReferenciasTitle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textColor="@color/on_background"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <ImageButton
                                android:id="@+id/referenciasRefreshButton"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:contentDescription="@string/empaque_contenido_refresh"
                                android:padding="6dp"
                                android:scaleType="centerInside"
                                android:src="@drawable/ic_refresh"
                                android:tint="@color/on_background" />
                        </LinearLayout>

                        <EditText
                            android:id="@+id/referenciasFilterInput"
                            android:layout_width="match_parent"
                            android:layout_height="36dp"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/bg_lote_id_input"
                            android:drawablePadding="6dp"
                            android:drawableStart="@drawable/ic_search"
                            android:hint="@string/empaque_referencia_filter_hint"
                            android:importantForAutofill="no"
                            android:imeOptions="actionSearch"
                            android:inputType="text"
                            android:maxLines="1"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:textColor="@color/on_background"
                            android:textColorHint="@color/on_surface_variant"
                            android:textSize="12sp" />

                        <LinearLayout
                            android:id="@+id/loteReferenciasList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:orientation="vertical" />

                        <TextView
                            android:id="@+id/loteReferenciasEmpty"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="12sp"
                            android:visibility="gone" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/productosScanSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/empaque_producto_scan_title"
                            android:textColor="@color/on_background"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <Spinner
                                android:id="@+id/productosScanUnidadSpinner"
                                android:layout_width="96dp"
                                android:layout_height="36dp"
                                android:background="@drawable/bg_lote_id_input"
                                android:paddingStart="2dp"
                                android:paddingEnd="2dp" />

                            <EditText
                                android:id="@+id/productosScanInput"
                                android:layout_width="0dp"
                                android:layout_height="36dp"
                                android:layout_marginStart="4dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_lote_id_input"
                                android:hint="@string/empaque_producto_scan_hint"
                                android:importantForAutofill="no"
                                android:imeOptions="actionDone"
                                android:inputType="text"
                                android:maxLines="1"
                                android:paddingStart="10dp"
                                android:paddingEnd="10dp"
                                android:textColor="@color/on_background"
                                android:textColorHint="@color/on_surface_variant"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/loteContentsSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/loteContentsTitle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textColor="@color/on_background"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <ImageButton
                                android:id="@+id/productosRefreshButton"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:contentDescription="@string/empaque_contenido_refresh"
                                android:padding="6dp"
                                android:scaleType="centerInside"
                                android:src="@drawable/ic_refresh"
                                android:tint="@color/on_background"
                                android:visibility="gone" />
                        </LinearLayout>

                        <EditText
                            android:id="@+id/productosFilterInput"
                            android:layout_width="match_parent"
                            android:layout_height="36dp"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/bg_lote_id_input"
                            android:drawablePadding="6dp"
                            android:drawableStart="@drawable/ic_search"
                            android:hint="@string/empaque_producto_filter_hint"
                            android:importantForAutofill="no"
                            android:imeOptions="actionSearch"
                            android:inputType="text"
                            android:maxLines="1"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:textColor="@color/on_background"
                            android:textColorHint="@color/on_surface_variant"
                            android:textSize="12sp"
                            android:visibility="gone" />

                        <LinearLayout
                            android:id="@+id/loteContentsList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:orientation="vertical" />

                        <TextView
                            android:id="@+id/loteContentsEmpty"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="12sp"
                            android:visibility="gone" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/deleteBlockedText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="11sp"
                        android:visibility="gone" />

                    <ProgressBar
                        android:id="@+id/createProgress"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="8dp"
                        android:visibility="gone" />
                </LinearLayout>
            </ScrollView>

            <LinearLayout
                android:id="@+id/errorContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/errorMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/on_background"
                    android:textSize="18sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/retryButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:minHeight="56dp"
                    android:text="@string/empaque_retry"
                    android:textSize="16sp" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/lotesListaOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background"
        android:clickable="true"
        android:elevation="8dp"
        android:focusable="true"
        android:visibility="gone" />

    </FrameLayout>

    <FrameLayout
        android:id="@+id/drawerPanel"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:clickable="true"
        android:focusable="true">

        <include
            android:id="@+id/drawerContent"
            layout="@layout/drawer_content_empaque" />
    </FrameLayout>

</androidx.drawerlayout.widget.DrawerLayout>
