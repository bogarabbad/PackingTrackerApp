<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface"
    android:orientation="vertical"
    android:paddingStart="@dimen/ui_list_row_padding_h"
    android:paddingTop="@dimen/ui_list_row_padding_v"
    android:paddingEnd="@dimen/ui_list_row_padding_h"
    android:paddingBottom="@dimen/ui_list_row_padding_v">

    <TextView
        android:id="@+id/loteIdText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/on_surface"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/loteTipoText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/on_surface_variant"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/loteMetaText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/on_surface_variant"
        android:textSize="12sp" />
</LinearLayout>
